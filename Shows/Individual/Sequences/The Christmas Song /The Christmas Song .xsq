        <Effect label="Will find it hard to sleep to night" startTime="61200" endTime="67100" />
        <Effect label="They know that Santa's on his way" startTime="67950" endTime="73750" />
        <Effect label="He's loaded lots of toys and goodies on his sleigh" startTime="74850" endTime="80250" />
        <Effect label="And every mother's child is gonna spy" startTime="81400" endTime="87200" />
        <Effect label="To see if reindeer really know how to fly" startTime="88000" endTime="94350" />
        <Effect label="And so I'm offering this simple phrase" startTime="95100" endTime="102150" />
        <Effect label="To kids from one to ninety two" startTime="103350" endTime="108100" />
