    <Element type="timing" name="Tree 1">
      <EffectLayer>
        <Effect label="Chest nuts roasting on an open fire" startTime="13500" endTime="19250" />
        <Effect label="Jack Frost nipping at your nose" startTime="20700" endTime="25350" />
        <Effect label="Yule tide carols being sung by a choir" startTime="27550" endTime="33200" />
        <Effect label="And folks dressed up like Eskimos" startTime="34100" endTime="38900" />
        <Effect label="Every body knows a turkey and some mistle toe" startTime="39750" endTime="47200" />
        <Effect label="Help to make the season bright" startTime="48700" endTime="53200" />
